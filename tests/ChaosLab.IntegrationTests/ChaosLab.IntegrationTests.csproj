<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Orders.Api and Payments.Api each declare their own top-level `Program`
      class, so referencing both directly would collide (CS0433). Each gets
      its own extern alias, confined to the Infrastructure folder; the tests
      themselves only see plain helpers and records.
    -->
    <ProjectReference Include="../../src/Orders.Api/Orders.Api.csproj">
      <Aliases>OrdersApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/Payments.Api/Payments.Api.csproj">
      <Aliases>PaymentsApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/Shared.Contracts/Shared.Contracts.csproj" />
    <ProjectReference Include="../../src/Chaos.Worker/Chaos.Worker.csproj" Aliases="ChaosWorker" />
  </ItemGroup>

</Project>